<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme الأساسي -->
    <style name="Theme.SpaceNewsApp" parent="Theme.MaterialComponents.DayNight.DayNight">
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/secondary_color</item>
        <item name="colorSecondaryVariant">@color/accent_color</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="fontFamily">@font/arabic_regular</item>
    </style>

    <style name="Theme.SpaceNewsApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- نمط العنوان المنطوي -->
    <style name="CollapsedTitleTextAppearance" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/arabic_bold</item>
    </style>

    <!-- نمط CardView -->
    <style name="NewsCardStyle">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="rippleColor">@color/ripple_color</item>
    </style>

    <!-- نمط FloatingActionButton -->
    <style name="SpaceFabStyle" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="android:layout_margin">16dp</item>
        <item name="tint">@android:color/white</item>
        <item name="rippleColor">@color/ripple_color</item>
    </style>

    <!-- نمط النص الأساسي -->
    <style name="PrimaryTextStyle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/arabic_regular</item>
    </style>

    <!-- نمط النص الثانوي -->
    <style name="SecondaryTextStyle" parent="PrimaryTextStyle">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- نمط العنوان -->
    <style name="TitleTextStyle" parent="PrimaryTextStyle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/arabic_bold</item>
    </style>

    <!-- نمط التبويبات -->
    <style name="TabLayoutStyle" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextColor">@color/tab_text_color</item>
        <item name="tabSelectedTextColor">@android:color/white</item>
        <item name="tabIndicatorColor">@android:color/white</item>
        <item name="tabRippleColor">@color/ripple_color</item>
    </style>
</resources>